# Optional collector credentials. Never prefix these with VITE_ or commit .env.
# Python reads environment variables; .env is NOT loaded automatically.
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
# Enable Google Cloud Billing API; restrict this key to that API.
# This is not a Gemini inference key or a billing-account/contract-pricing API.
GOOGLE_CLOUD_BILLING_API_KEY=
